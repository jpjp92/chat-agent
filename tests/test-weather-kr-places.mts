/**
 * 국내 시·군 좌표표 하니스 — `npx tsx tests/test-weather-kr-places.mts` (네트워크·환경변수 없음)
 *
 * 왜 있는가(PLAN_WEATHER_MID_FORECAST_261125 §2-2): 한글 지명을 OWM 위치 변환에 그대로 보내 중기 지점 175곳 중 60곳이
 * 틀렸다 — 못 찾음(속초·평택), 외국(구리·안양 → 중국, 안산 → 프랑스), 다른 동네(경기 광주 → 광주광역시).
 * 그 60곳이 모두 제 도 안 좌표로 풀리는지, 동명·표기 변형·해외·일반 명사를 고정한다.
 */
import fs from 'node:fs';
import { findKrPlace } from '../server/lib/weather/kr-places.js';
import { isKnownCityName } from '../server/lib/weather/index.js';

let pass = 0, fail = 0;
const check = (name: string, cond: boolean, detail = '') => {
    if (cond) { pass++; console.log(`✅ ${name}`); } else { fail++; console.log(`❌ ${name}${detail ? `\n     ${detail}` : ''}`); }
};

// 중기 구역 코드 앞 4자 → 도 범위(위도·경도 대략)
const BOX: Record<string, number[]> = {
    '11B2': [36.9, 38.3, 126.0, 127.9], '11C1': [36.0, 37.3, 127.2, 128.8], '11C2': [35.9, 37.1, 125.9, 127.7],
    '11E0': [37.0, 37.6, 130.5, 132.0], '11F1': [35.2, 36.2, 126.3, 127.9], '21F1': [35.2, 36.2, 126.3, 127.9],
    '11F2': [33.9, 35.6, 125.0, 127.9], '21F2': [33.9, 35.6, 125.0, 127.9], '11G0': [33.0, 34.1, 126.0, 127.0],
    '11H1': [35.5, 37.6, 127.7, 132.0], '11H2': [34.5, 35.95, 127.5, 129.5], '11D1': [37.0, 38.7, 127.0, 129.6],
    '11D2': [37.0, 38.7, 127.0, 129.6],
};
// 11-25 실측에서 OWM 이 틀린 59곳(이어도 — 바다 위 기지 — 제외). 동명은 도명을 붙인 질의로.
const BROKEN: [string, string][] = [
    ['11B2', '구리'], ['11B2', '안양'], ['11B2', '평택'], ['11B2', '경기 광주'], ['11B2', '안산'], ['11C1', '단양'], ['11C1', '괴산'],
    ['11C1', '추풍령'], ['11C1', '영동'], ['11C1', '옥천'], ['11C2', '태안'], ['11C2', '보령'], ['11C2', '서천'], ['11C2', '아산'],
    ['11C2', '예산'], ['11C2', '청양'], ['11C2', '금산'], ['11E0', '독도'], ['11F1', '순창'], ['11F2', '완도'], ['11F2', '장흥'],
    ['11F2', '구례'], ['11F2', '곡성'], ['11G0', '성산'], ['11G0', '성판악'], ['11G0', '고산'], ['11G0', '추자도'], ['11G0', '산천단'],
    ['11G0', '한남'], ['11H1', '청도'], ['11H1', '칠곡'], ['11H2', '합천'], ['11H2', '의령'], ['11H2', '함안'], ['11H2', '하동'],
    ['21F1', '부안'], ['21F2', '진도'], ['21F2', '신안'], ['21F2', '무안'], ['11D1', '철원'], ['11D1', '양구'], ['11D1', '평창'],
    ['11D2', '대관령'], ['11D2', '태백'], ['11D2', '속초'], ['11D2', '강원 고성'], ['11D2', '삼척'], ['11H1', '영덕'], ['11H1', '봉화'],
    ['11H1', '영양'], ['11H1', '청송'], ['11H1', '고령'], ['11H1', '성주'], ['11F1', '익산'], ['11F1', '정읍'], ['11F1', '완주'],
    ['11F1', '장수'], ['11F1', '무주'], ['11F1', '진안'],
];
const misplaced = BROKEN.filter(([code, name]) => {
    const p = findKrPlace(name); const b = BOX[code];
    return !p || !(p.lat >= b[0] && p.lat <= b[1] && p.lon >= b[2] && p.lon <= b[3]);
}).map(([, n]) => n);
check(`OWM 이 틀린 ${BROKEN.length}곳 모두 제 도 안 좌표`, misplaced.length === 0, misplaced.join(', '));

const at = (q: string) => findKrPlace(q);
const near = (q: string, lat: number, lon: number) => { const p = at(q); return !!p && Math.abs(p.lat - lat) < 0.05 && Math.abs(p.lon - lon) < 0.05; };
check('동명: 광주·광주시·광주광역시·전남 광주 → 광주광역시', ['광주', '광주시', '광주광역시', '전남 광주'].every(q => near(q, 35.16, 126.85)));
check('동명: 경기 광주·경기도 광주시 → 경기 광주', near('경기 광주', 37.43, 127.26) && near('경기도 광주시', 37.43, 127.26) && at('경기 광주')?.label === '경기 광주');
check('동명: 고성 → 경남, 강원 고성·강원도 고성군 → 강원', near('고성', 34.97, 128.32) && near('강원 고성', 38.38, 128.47) && near('강원도 고성군', 38.38, 128.47));
check('표기 변형: 속초시·속초 시·강원 속초·강원특별자치도 속초시', ['속초시', '속초 시', '강원 속초', '강원특별자치도 속초시'].every(q => near(q, 38.21, 128.59)));
check('표기 변형: 서울특별시·제주도·제주시·울릉', near('서울특별시', 37.57, 126.98) && near('제주도', 33.5, 126.53) && near('제주시', 33.5, 126.53) && !!at('울릉'));
check('해외·모르는 이름은 표 밖(OWM 으로)', ['도쿄', 'Tokyo', '파리', '해운대', '강남구', '뉴욕 맨해튼', ''].every(q => at(q) === undefined));
check('시·군 + 구·동 → 앞 시·군(부산 해운대·서울 강남구·경기 광주 오포)', near('부산 해운대', 35.18, 129.08) && near('서울 강남구', 37.57, 126.98) && near('경기 광주 오포', 37.43, 127.26));
check('"시"·"군" 이 이름의 일부인 2글자는 떼지 않음(이천 ≠ 이)', at('이천')?.label === '이천' && at('군산')?.label === '군산');

check('후속 판정: 시·군 이름은 아는 도시(속초·평택)', isKnownCityName('속초') && isKnownCityName('평택') && isKnownCityName('도쿄'));
check('후속 판정: 일반 명사 겸 지명은 아님(영양·장수)', !isKnownCityName('영양') && !isKnownCityName('장수'));

const src = fs.readFileSync(new URL('../server/lib/weather/index.ts', import.meta.url), 'utf8');
check('geocode 가 OWM 호출 전에 좌표표를 본다', /async function geocode[\s\S]{0,200}findKrPlace\(normalized\)[\s\S]{0,300}geo\/1\.0\/direct/.test(src));
check('별칭표에 국내 도시가 남지 않음(이중 관리 방지)', !/CITY_ALIASES[\s\S]*?'[A-Za-z ]+,KR'[\s\S]*?\n};/.test(src));

console.log(`\n${fail ? '❌' : '✅'} 통과 ${pass} · 실패 ${fail}`);
process.exit(fail ? 1 : 0);
