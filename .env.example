# `.env.local` 로 복사해서 채운다.  cp .env.example .env.local
#
# [필수] 없으면 앱이 동작하지 않음 / [선택] 없으면 해당 기능만 비활성
# Vercel 배포 시 Production·Preview 스코프에 각각 등록해야 한다.
# 변수 배선 상세: docs/guide/REF_Architecture.md

# ── [필수] Gemini API Keys ─────────────────────────────────
# `^API_KEY\d*$` 패턴에 맞는 환경변수를 전부 모아 키 풀로 쓴다(server/config.ts).
# 최소 1개 필수. API_KEY2~ 는 429 대응 로테이션용 선택 항목.
API_KEY=your_gemini_api_key
API_KEY2=
API_KEY3=

# ── [필수] Supabase — 서버 (service role) ──────────────────
# 서버 라우트에서만 사용. 절대 클라이언트에 노출되면 안 된다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
# SUPABASE_SERVICE_ROLE_KEY 를 따로 두면 admin 클라이언트가 그걸 우선 사용한다.
# 미설정 시 SUPABASE_KEY 로 폴백하므로, 위에 service_role 키를 넣었다면 생략 가능.
# SUPABASE_SERVICE_ROLE_KEY=

# ── [필수] Supabase — 클라이언트 (인증) ────────────────────
# 🔴 없으면 앱이 throw 한다 (lib/supabase/client.ts · lib/supabase/route.ts). 폴백 없음.
# NEXT_PUBLIC_ 접두사라 **빌드 타임에 번들에 구워진다** — 값을 바꾸면 재배포 필요.
# anon 키는 공개되어도 되는 값이지만, 반드시 RLS 가 켜져 있어야 안전하다.
# 적용 SQL: scripts/sql/auth-mvp-*.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── [선택] 공공 API (약국·병원·동물병원·법령) ───────────────
# 공공데이터포털(data.go.kr) 발급 — 약국과 HIRA 병원이 **같은 키를 공유**한다.
PHARM_KEY=your_public_data_portal_key
# 행정안전부 동물병원 조회서비스
VET_KEY=your_public_data_portal_key
# 국가법령정보센터 Open API OC 코드
LAW_OC=your_law_oc_code

# ── [선택] MFDS 의약품 낱알식별 ─────────────────────────────
MFDS_API_ENDPOINT=https://apis.data.go.kr/1471000/MdcinGrnIdntfcInfoService03/getMdcinGrnIdntfcInfoList03
MFDS_API_KEY=your_mfds_api_key

# ── [선택] OpenAI 채팅 모델 + URL Fetch 폴백 ───────────────
# GPT-5.4 mini/GPT-5.6 luna 채팅 선택 및 OpenAI URL 보조 폴백에 사용한다.
# 서버 전용 키이며 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
OPENAI_API_KEY_TIER1=your_openai_api_key
# OpenAI Responses web_search — Brunch/Wikidocs 보조 폴백(현재 기본 비활성).
# true로 명시한 경우에만 ScrapingBee·browserless 실패 후 호출한다.
OPENAI_URL_FALLBACK_ENABLED=false
# 검증된 기본값은 gpt-5-mini. 다른 모델은 server/openai/models.ts capability 등록 후 사용한다.
# OPENAI_URL_FETCH_MODEL=gpt-5-mini
# ScrapingBee — Wikidocs 및 일반 사이트의 우선 렌더링 폴백
SCRAPINGBEE_KEY=your_scrapingbee_key
# browserless — 일반 렌더링 폴백 + CGV 상영시간 (BROWSERLESS_TOKEN 도 같은 용도로 인식)
BROWSERLESS_KEY=your_browserless_token
# browserless 엔드포인트 오버라이드. 미설정 시 https://production-sfo.browserless.io
# BROWSERLESS_REST_URL=

# ── [선택] 스포츠 ──────────────────────────────────────────
# football-data.org v4 (TIER_ONE 플랜)
SPORTS_API_KEY=your_football_data_org_token

# ── [선택] 날씨 (weather intent) ───────────────────────────
# 기상청 API Hub authKey (apihub.kma.go.kr, 20,000회/일) — 한국 도시
KMA_API_KEY=your_kma_apihub_authkey
# OpenWeather — geocoding + 해외/KMA 폴백 (OPENWEATHER_KEY 도 같은 용도로 인식)
OPENWEATHER_API_KEY=your_openweather_api_key

# ── [선택] 논문 조회 (PubMed / CrossRef) ───────────────────
# arXiv API 는 키가 필요 없다 — 별도 환경변수 없음(요청 간 3초 간격만 지킨다).
# NCBI E-utilities API 키. 없어도 동작하지만 무키는 3 req/s 라 병렬 호출에서 429 가 난다.
# Vercel 은 동시 인스턴스가 egress IP 를 공유하므로 배포 환경에서는 사실상 필수.
# 발급: NCBI 계정 → Account settings → API Key Management
NCBI_KEY=your_ncbi_eutils_api_key
# NCBI `email` / CrossRef `mailto`(polite pool) 용 연락처. 비어 있으면 파라미터를 보내지 않는다.
# PAPER_API_CONTACT=

# ── [선택] 네이버 검색 (도입 검토 중) ──────────────────────
# 개발자센터 애플리케이션의 Client ID/Secret. 검색 API 9종 사용 가능하나
# doc(전문자료)·papago·단축URL 은 폐지됐고 DataLab 은 별도 이용신청이 필요하다.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# ── [선택] 개발용 스위치 ───────────────────────────────────
# 1 이면 라우터의 후속질문 LLM 판정을 끄고 규칙만 사용한다(A/B 측정용).
# DISABLE_LLM_FOLLOWUP=
