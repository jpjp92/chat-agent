# ── Gemini API Keys ────────────────────────────────────────
# 최소 1개 필수. API_KEY2~ 는 키 풀 로테이션(429 대응)용 선택 항목
API_KEY=your_gemini_api_key
API_KEY2=
API_KEY3=

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ── 공공 API (약국·병원·동물병원·법령) ──────────────────────
# 공공데이터포털(data.go.kr) 발급 — 약국·HIRA 병원 공용 키
PHARM_KEY=your_public_data_portal_key
# HIRA 병원정보서비스 (PHARM_KEY와 동일 키 사용 가능)
HOSPITAL_KEY=your_public_data_portal_key
# 행정안전부 동물병원 조회서비스
VET_KEY=your_public_data_portal_key
# 국가법령정보센터 Open API OC 코드
LAW_OC=your_law_oc_code

# ── MFDS 의약품 낱알식별 ────────────────────────────────────
MFDS_API_ENDPOINT=https://apis.data.go.kr/1471000/MdcinGrnIdntfcInfoService03/getMdcinGrnIdntfcInfoList03
MFDS_API_KEY=your_mfds_api_key

# ── URL Fetch 폴백 (선택) ───────────────────────────────────
# ScrapingBee — 일반 사이트 폴백 + wikidocs 1차
SCRAPINGBEE_KEY=your_scrapingbee_key
# browserless — wikidocs 2차 + CGV 상영시간
BROWSERLESS_KEY=your_browserless_token
# ScraperAPI — wikidocs 3차 최종 폴백
SCRAPER_KEY=your_scraperapi_key

# ── 스포츠 ─────────────────────────────────────────────────
# football-data.org v4 (TIER_ONE 플랜)
SPORTS_API_KEY=your_football_data_org_token

# ── 영화관 상영시간 (선택) ──────────────────────────────────
KOBIS_API_KEY=your_kobis_key
